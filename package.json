{
  "name": "workbench",
  "private": true,
  "workspaces": [
    "apps/reader",
    "apps/med",
    "apps/arctic/Web",
    "packages/*",
    "apps/spaced2",
    "apps/podcast-lab",
    "apps/arctic/Browser",
    "apps/sync-server",
    "apps/sync-backup"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/reader dev",
    "build": "bun run --cwd apps/reader build",
    "lint": "oxlint apps/reader packages apps/arctic/Web && bun run --cwd apps/med lint",
    "lint:fix": "oxlint --fix apps/reader packages apps/arctic/Web && bun run --cwd apps/med lint:fix",
    "preview": "bun run --cwd apps/reader preview",
    "deploy": "bun run --cwd apps/reader deploy",
    "cf-typegen": "bun run --cwd apps/reader cf-typegen",
    "auth:generate": "bun run --cwd apps/reader auth:generate",
    "db:generate": "bun run --cwd apps/reader db:generate",
    "db:migrate:local": "bun run --cwd apps/reader db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/reader db:migrate:remote",
    "test": "bun run --cwd apps/reader test",
    "test:client": "bun run --cwd apps/reader test:client",
    "test:server": "bun run --cwd apps/reader test:server",
    "test:watch": "bun run --cwd apps/reader test:watch",
    "test:e2e": "bun run --cwd apps/reader test:e2e",
    "test:e2e:ui": "bun run --cwd apps/reader test:e2e:ui",
    "test:e2e:headed": "bun run --cwd apps/reader test:e2e:headed",
    "diagnostics:reader": "bun run --cwd apps/reader diagnostics:reader",
    "diagnostics:network": "bun run --cwd apps/reader diagnostics:network",
    "benchmark:highlights": "bun run --cwd apps/reader benchmark:highlights",
    "benchmark:reader-startup": "bun run --cwd apps/reader benchmark:reader-startup",
    "db:backup-remote": "bun run --cwd apps/reader db:backup-remote",
    "format": "oxfmt apps/reader packages apps/arctic/Web *.md package.json && bun run --cwd apps/med format",
    "format:check": "oxfmt --check apps/reader packages apps/arctic/Web *.md package.json && bun run --cwd apps/med format:check",
    "build:packages": "bun run --cwd packages/text-highlighter build && bun run --cwd packages/local-sync build",
    "test:sync": "bun run --cwd apps/reader test:sync",
    "dev:reader": "bun run --cwd apps/reader dev",
    "build:reader": "bun run --cwd apps/reader build",
    "build:arctic-web": "bun run --cwd apps/arctic/Web build",
    "test:arctic-web": "bun run --cwd apps/arctic/Web test",
    "test:packages": "bun run build:packages && bun run --cwd packages/local-sync test && bun run --cwd packages/text-highlighter test && bun run --cwd packages/arctic-sync-server test",
    "med": "node apps/med/dist/cli.js",
    "dev:med": "node apps/med/scripts/dev.mjs",
    "build:med": "bun run --cwd apps/med build",
    "test:med": "bun run --cwd apps/med test:integration && bun run --cwd apps/med test:browser && bun run --cwd apps/med test:unit",
    "check:med": "bun run --cwd apps/med check",
    "lint:med": "bun run --cwd apps/med lint",
    "format:med": "bun run --cwd apps/med format",
    "format:check:med": "bun run --cwd apps/med format:check",
    "dev:spaced2": "bun run --cwd apps/spaced2 dev",
    "build:spaced2": "bun run --cwd apps/spaced2 build",
    "test:spaced2": "bun run --cwd apps/spaced2 test",
    "lint:spaced2": "bun run --cwd apps/spaced2 lint",
    "deploy:spaced2": "bun run --cwd apps/spaced2 deploy",
    "preview:spaced2": "bun run --cwd apps/spaced2 preview",
    "dev:spaced2-server": "bun run --cwd apps/spaced2 dev:server",
    "dev:podcast": "bun run --cwd apps/podcast-lab dev",
    "test:podcast": "bun run --cwd apps/podcast-lab test",
    "dev:arctic-browser": "bun run --cwd apps/arctic/Browser dev",
    "build:arctic-browser": "bun run --cwd apps/arctic/Browser build",
    "test:arctic-browser": "bun run --cwd apps/arctic/Browser test",
    "seed:arctic-browser": "bun run --cwd apps/arctic/Browser seed",
    "dev:sync": "bun run --cwd apps/sync-server dev",
    "db:sync:local": "bun run --cwd apps/sync-server db:migrate",
    "test:sync-server": "bun run build:packages && bun run --cwd apps/sync-server test",
    "build:sync-server": "bun run build:packages && bun run --cwd apps/sync-server build",
    "dev:reader:shared": "VITE_SHARED_API_URL=http://localhost:8792 bun run --cwd apps/reader dev --host localhost --port 5175 --strictPort",
    "dev:spaced2:shared": "VITE_SHARED_API_URL=http://localhost:8792 bun run --cwd apps/spaced2 dev --host localhost",
    "dev:shared": "bun scripts/dev-shared.ts",
    "test:shared:e2e": "bun run --cwd apps/sync-server test:e2e",
    "deploy:sync": "bun run --cwd apps/sync-server deploy",
    "wb": "bun apps/sync-backup/src/cli.ts",
    "test:sync-backup": "bun run --cwd apps/sync-backup test"
  },
  "devDependencies": {
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  }
}
