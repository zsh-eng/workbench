{
  "name": "@workbench/sync-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8792",
    "db:migrate": "wrangler d1 migrations apply workbench-sync-local --local",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "@zsh-eng/local-sync": "workspace:*",
    "better-auth": "1.6.9",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.15",
    "ua-parser-js": "2.0.9",
    "xxhash-wasm": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@cloudflare/workers-types": "5.20260919.1",
    "@playwright/test": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "4.135.0"
  }
}
