{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaced2",
  "routes": [
    {
      "pattern": "spaced2.zsheng.app/*",
      "zone_id": "3c8968de3ec21966c6cf0a184c37124c",
    },
  ],
  "main": "server/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "spaced2-v2",
      "database_id": "3ec0ff8a-230f-4c3a-8d93-4d4c9e58007b",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "spaced2-files-v2",
    },
  ],
  "vars": {
    "SYNC_CUTOVER_MODE": "retired",
    "BASE_URL": "https://spaced2.zsheng.app",
    "MAIL_MODE": "resend",
    "MAIL_FROM": "Spaced <no-reply@updates.spaced.zsheng.app>",
  },
  "env": {
    "local": {
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "spaced2-v2",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "spaced2-files-v2",
        },
      ],
      "vars": {
        "BASE_URL": "http://localhost:5180",
        "MAIL_MODE": "console",
        "GOOGLE_CLIENT_ID": "local-test",
        "GOOGLE_CLIENT_SECRET": "local-test",
        "BETTER_AUTH_SECRET": "local-only-spaced2-auth-secret-for-tests",
      },
    },
  },
}
