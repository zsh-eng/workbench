{
  "name": "@workbench/spaced2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:packages && vite --port 5180 --strictPort",
    "build": "bun run build:packages && tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "test": "bun run build:packages && bun test ./src ./tests ./server ./scripts/sync-optimization-benchmark",
    "spaced-compile": "bun run ./scripts/spaced-compile.ts",
    "preview": "bun run build && wrangler dev --env local --local --port 8791 --persist-to consolidation.local/state --var BASE_URL:http://localhost:8791",
    "deploy": "bun run build && bun scripts/assert-deploy-config.ts && wrangler deploy",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/telescope.svg",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "dev:server": "bun run build:packages && wrangler dev --env local --local --port 8791 --persist-to consolidation.local/state",
    "db:migrate:local": "wrangler d1 migrations apply spaced2-v2 --env local --local --persist-to consolidation.local/state",
    "build:packages": "bun run --cwd ../../packages/local-sync build"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "@hookform/resolvers": "3.9.1",
    "@icons-pack/react-simple-icons": "11.2.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.5",
    "@radix-ui/react-dropdown-menu": "2.1.5",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-navigation-menu": "1.2.4",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-select": "2.1.5",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@uidotdev/usehooks": "2.4.1",
    "@zsh-eng/local-sync": "workspace:*",
    "better-auth": "1.6.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "4.1.0",
    "dexie": "4.4.2",
    "dexie-react-hooks": "1.1.7",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
