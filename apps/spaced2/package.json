    "lucide-react": "0.468.0",
    "next-themes": "0.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.1",
    "react-router": "7.0.2",
    "recharts": "2.15.1",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.1",
    "sonner": "1.7.4",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
