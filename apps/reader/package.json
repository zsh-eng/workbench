{
  "name": "@workbench/reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:packages && vite",
    "dev:local-data": "bun run build:packages && vite --mode local-data",
    "build": "bun run build:packages && tsc -b && vite build",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix .",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "bun x @better-auth/cli generate --config ./better-auth.config.ts --output ./server/db/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply reader-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply reader-db --remote",
    "test": "bun run build:packages && NODE_OPTIONS=\"--no-webstorage\" vitest",
    "test:client": "bun run build:packages && NODE_OPTIONS=\"--no-webstorage\" vitest --project client",
    "test:server": "bun run build:packages && NODE_OPTIONS=\"--no-webstorage\" vitest --project server",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "diagnostics:reader": "bun scripts/reader-diagnostics.ts",
    "diagnostics:network": "VITE_BETTER_AUTH_URL=http://127.0.0.1:5196 bun run build && bun scripts/network-lab.ts",
    "benchmark:highlights": "bun run build && bun x vite build --config scripts/highlights-performance/vite.config.ts && bun scripts/highlights-performance/benchmark.ts",
    "benchmark:reader-startup": "bun run build && bun scripts/benchmark-reader-startup.ts",
    "db:backup-remote": "bun scripts/backup-remote-d1.ts",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "build:packages": "bun run --cwd ../../packages/text-highlighter build && bun run --cwd ../../packages/local-sync build",
    "test:sync": "bun run --cwd ../../packages/local-sync build && bun run --cwd ../../packages/local-sync test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@chenglou/pretext": "^0.0.9",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@jsquash/webp": "^1.5.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@workbench/arctic-sync-server": "workspace:*",
    "@zsh-eng/local-sync": "workspace:*",
    "@zsh-eng/text-highlighter": "workspace:*",
    "better-auth": "^1.6.9",
    "blurhash": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.2",
    "hono": "^4.12.15",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.14.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "ua-parser-js": "^2.0.9",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "^1.33.2",
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.85.0"
  }
}
