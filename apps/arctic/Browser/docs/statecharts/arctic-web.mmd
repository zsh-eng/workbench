stateDiagram-v2
  %% Arctic for the web on a phone, drawn by hand from ArcticWeb.tla on
  %% 24 October 2026. A label with [breaks rule n] ends a bug's path.
  %% never After you cancel the link bar, nothing you did in it gets saved.
  %% never When a save from the link bar is done, its card is in view.
  %% never Once things settle while online, the Text and theme sheet you tapped is on screen.
  state "Arctic on a phone" as App {
    state "Library and link bar" as Shell {
      state "Library" as Library
      state "Library, filtered" as Filtered
      state "Link bar, empty" as BarEmpty
      state "Link bar, text typed" as BarText
      state "Link bar, waiting for the clipboard" as BarWaiting
      state "Library, the clipboard read goes on" as Orphan
      state "Saving" as Saving
      state "Saved link at the top" as SavedTop
      state "Saved after Cancel [breaks rule 1]" as SavedAfterCancel
      state "Saved link hidden by the filter [breaks rule 2]" as SavedHidden
      state "Reading" as Reading
      [*] --> Library
      Library --> Filtered : Search, or pick a topic
      Filtered --> Library : Clear the search
      Library --> BarEmpty : Tap +
      Filtered --> BarEmpty : Tap +
      BarEmpty --> BarText : Type
      BarText --> BarText : Tap Save on prose shows a note
      BarText --> Saving : Tap Save
      BarEmpty --> BarWaiting : Tap Paste
      BarWaiting --> Saving : The clipboard gives a link
      BarWaiting --> BarEmpty : The browser refuses the clipboard
      BarEmpty --> Library : Tap × or the list
      BarText --> Library : Tap × or the list
      BarWaiting --> Orphan : Tap × or the list
      Orphan --> SavedAfterCancel : The clipboard gives a link
      Orphan --> Library : The browser refuses the clipboard
      Saving --> SavedTop : The save finishes, no filter
      Saving --> SavedHidden : The save finishes, filter on
      SavedTop --> Library
      SavedHidden --> Filtered
      Library --> Reading : Open an article
      Reading --> Library : Back
    }
    --
    state "Text and theme sheet" as Sheet {
      state "Code not loaded" as CodeAbsent
      state "Code loading" as CodeLoading
      state "Code loaded" as CodeLoaded
      state "Sheet open" as SheetOpen
      state "Nothing opens until a reload [breaks rule 3]" as CodeFailed
      [*] --> CodeAbsent
      CodeAbsent --> CodeLoading : Arctic preloads, or Tap Text and theme
      CodeLoading --> CodeLoaded : Online, or the code is cached
      CodeLoading --> CodeFailed : Offline, and the code is not cached
      CodeLoaded --> SheetOpen : Tap Text and theme
      SheetOpen --> CodeLoaded : Close the sheet
      CodeFailed --> CodeFailed : Tap again, or the connection returns
    }
    --
    state "Network" as Net {
      [*] --> Online
      Online --> Offline : The connection drops
      Offline --> Online : The connection returns
    }
  }
