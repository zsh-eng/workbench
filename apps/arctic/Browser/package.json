{
  "name": "@workbench/arctic-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:sync && vite",
    "build": "bun run build:sync && tsc --noEmit && vite build",
    "build:sync": "bun run --cwd ../../../packages/local-sync build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "test": "playwright test",
    "copies": "bun scripts/copies.ts",
    "upload": "bun scripts/upload.ts",
    "test:service": "bun test server/service.test.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@workbench/elements": "workspace:*",
    "@zsh-eng/local-sync": "workspace:*",
    "defuddle": "0.19.4",
    "dompurify": "3.4.15",
    "linkedom": "0.18.13",
    "lucide-react": "^0.546.0",
    "playwright": "1.59.1",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "1.3.9",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
