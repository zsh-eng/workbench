{
  "name": "@workbench/arctic-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:highlighter && bun scripts/dev.ts",
    "build": "bun run build:highlighter && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5186",
    "seed": "bun scripts/seed.ts",
    "test": "playwright test",
    "build:highlighter": "bun run --cwd ../../../packages/text-highlighter build",
    "dev:ui": "vite --host 127.0.0.1 --port 5186",
    "service": "bun server/index.ts",
    "test:service": "bun test server/service.test.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@zsh-eng/text-highlighter": "workspace:*",
    "dompurify": "3.4.15",
    "lucide-react": "^0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.14.2",
    "defuddle": "0.19.4",
    "linkedom": "0.18.13",
    "playwright": "1.59.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "^20.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@types/bun": "1.3.9"
  }
}
