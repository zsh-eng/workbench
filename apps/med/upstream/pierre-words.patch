index 0000000..7b2e960
--- /dev/null
+++ b/packages/words/test/source_test.ts
@@ -0,0 +1,106 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { renderToHtml } from '../dist/index.js';
+
+const dec = new TextDecoder();
+const html = (input: string, options = {}) =>
+  dec.decode(renderToHtml(input, { sourceLines: true, ...options }));
+
+/** The lines of each top-level block, and the HTML before each mark. */
+function blocks(input: string, options = {}) {
+  const parts = html(input, options).split('\0');
+  const found: { lines: string; html: string }[] = [];
+  for (let at = 1; at < parts.length; at += 2)
+    found.push({ lines: parts[at], html: parts[at - 1].trim() });
+  return { found, rest: parts.at(-1)!.trim() };
+}
+
+test('each top-level block ends with its source lines', () => {
+  const { found } = blocks(
+    '# Title\n\nOne\ntwo\n\n- a\n- b\n\n  c\n\n> q\n> r\n\n```ts\nx\n```\n\n---\n\n| a |\n|---|\n| 1 |\n\nSetext\n===\n\n    code\n'
+  );
+  assert.deepEqual(
+    found.map((block) => block.lines),
+    ['1,1', '3,4', '6,9', '11,12', '14,16', '18,18', '20,22', '24,25', '27,27']
+  );
+});
+
+test('headings, code blocks, and tables name their lines', () => {
+  const { found } = blocks('Setext\n===\n\n```\nx\n```\n\n| a |\n|---|\n');
+  assert.equal(
+    found[0].html,
+    '<h1 data-source-line="1" data-source-end="2">Setext</h1>'
+  );
+  assert.match(found[1].html, /^<pre data-source-line="4" data-source-end="6">/);
+  assert.match(found[2].html, /^<table data-source-line="8" data-source-end="9">/);
+});
+
+test('nested blocks and lazy lines widen the block that holds them', () => {
+  const { found } = blocks(
+    '> - a\n>\n>   ```\n>   x\n>   ```\n> - b\nlazy\n\nafter\n'
+  );
+  assert.deepEqual(
+    found.map((block) => block.lines),
+    ['1,7', '9,9']
+  );
+  assert.match(found[0].html, /<pre data-source-line="3" data-source-end="5">/);
+});
+
+test('definitions and footnotes are not blocks; footnotes follow the last mark', () => {
+  const { found, rest } = blocks('[a]: /x\n\nNote[^1] [a].\n\n[^1]: Text.\n\nEnd\n');
+  assert.deepEqual(
+    found.map((block) => block.lines),
+    ['3,3', '7,7']
+  );
+  assert.match(rest, /^<section class="footnotes" data-footnotes>/);
+  assert.doesNotMatch(rest, /data-source-line/);
+});
+
+test('an HTML block is escaped text in a template', () => {
+  const { found } = blocks('<details>\n<summary>S</summary>\n\nBody\n\n</details>\n', {
+    skipHtml: true,
+  });
+  assert.equal(
+    found[0].html,
+    '<template data-html data-source-line="1" data-source-end="2">&lt;details&gt;\n&lt;summary&gt;S&lt;/summary&gt;</template>'
+  );
+  assert.equal(found[2].html, '<template data-html data-source-line="6" data-source-end="6">&lt;/details&gt;</template>');
+});
+
+test('inline HTML is escaped text in a template', () => {
+  const { found } = blocks('a <img src="x.png" alt="b&c">\nd <b>e</b>\n', { skipHtml: true });
+  assert.equal(
+    found[0].html,
+    '<p>a <template data-html>&lt;img src=&quot;x.png&quot; alt=&quot;b&amp;c&quot;&gt;</template>\nd <template data-html>&lt;b&gt;</template>e<template data-html>&lt;/b&gt;</template></p>'
+  );
+  // An image's alt text keeps the tag as its text, as without the option.
+  assert.match(html('![a <b>c</b>](x.png)'), /alt="a &lt;b&gt;c&lt;\/b&gt;"/);
+});
+
+test('line ends count at each LF, with CRLF input', () => {
+  const { found } = blocks('a\r\n\r\n# b\r\n');
+  assert.deepEqual(
+    found.map((block) => block.lines),
+    ['1,1', '3,3']
+  );
+});
+
+test('only $$ starts math with doubleDollarMath, and mathSource writes TeX', () => {
+  const options = { math: true, doubleDollarMath: true, mathSource: true };
+  const { found } = blocks('$HOME and $3, $$x<1$$.\n\n$$\na\n$$\n', options);
+  assert.equal(
+    found[0].html,
+    '<p>$HOME and $3, <code class="language-math math-inline">x&lt;1</code>.</p>'
+  );
+  assert.equal(
+    found[1].html,
+    '<pre data-source-line="3" data-source-end="5"><code class="language-math math-display">a</code></pre>'
+  );
+  assert.match(html('$x$', { math: true }), /<svg/);
+});
+
+test('without the option, output is unchanged', () => {
+  const input = '# a\n\n- b\n\n```\nc\n```\n\n<div>d</div>\n';
+  assert.doesNotMatch(dec.decode(renderToHtml(input)), /\0|data-source/);
+});
