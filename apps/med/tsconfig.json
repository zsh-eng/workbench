{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    // One vitest for the tests and for @vitest/browser's matchers (expect.element):
    // Bun links a peer variant of the same version for each, and the matchers
    // would extend the other one.
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src", "tests", "*.config.ts"]
}
