{
  "name": "@workbench/med",
  "version": "0.1.6",
  "private": true,
  "description": "Local continuous diff review with commit history",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zsh-eng/workbench.git",
    "directory": "apps/med"
  },
  "bin": {
    "med": "dist/cli.js",
    "med-diff": "dist/cli.js"
  },
  "files": [
    "dist",
    "upstream",
    "tools/zoekt",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "bun run typecheck && bun run build:web && bun run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "check": "bun run format:check && bun run lint && bun run test:integration && bun run test:browser && bun run test:unit && bun run test:e2e",
    "start": "node dist/cli.js",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "test:integration": "vitest run --project integration",
    "test:e2e": "bun run build && node scripts/validate-review-links.mjs && node scripts/validate-multi-repo.mjs && node scripts/validate-welcome.mjs",
    "test:highlighting": "vitest run --project integration tests/integration/highlighter-parity.test.ts",
    "compare:highlighting": "bun scripts/check-highlighter-parity.ts",
    "build:executable": "bun run build && bun scripts/build-executable.ts",
    "test:service": "node scripts/validate-service.mjs",
    "test:restart": "node scripts/validate-restart.mjs",
    "test:navigation": "bun run build && node scripts/validate-navigation-workflows.mjs",
    "test:media": "node scripts/validate-media.mjs",
    "test:markdown-links": "node scripts/validate-markdown-links.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@replit/codemirror-vim": "6.4.0",
    "@stylexjs/stylex": "0.19.1",
    "@twinkleplop/bash": "0.1.4",
    "@twinkleplop/core": "0.2.1",
    "@twinkleplop/css": "0.1.4",
    "@twinkleplop/diff": "0.1.4",
    "@twinkleplop/dotenv": "0.1.4",
    "@twinkleplop/go": "0.1.4",
    "@twinkleplop/html": "0.1.4",
    "@twinkleplop/http": "0.1.4",
    "@twinkleplop/ini": "0.1.4",
    "@twinkleplop/javascript": "0.1.4",
    "@twinkleplop/json": "0.1.4",
    "@twinkleplop/jsonc": "0.1.1",
    "@twinkleplop/markdown": "0.1.4",
    "@twinkleplop/python": "0.1.4",
    "@twinkleplop/rust": "0.1.4",
    "@twinkleplop/shellsession": "0.1.4",
    "@twinkleplop/sql": "0.1.4",
    "@twinkleplop/svelte": "0.1.4",
    "@twinkleplop/toml": "0.1.4",
    "@twinkleplop/tsx": "0.1.4",
    "@twinkleplop/typescript": "0.1.4",
    "@twinkleplop/yaml": "0.1.4",
    "chokidar": "5.0.0",
    "decode-named-character-reference": "1.3.0",
    "hast-util-from-html-isomorphic": "2.0.0",
    "katex": "0.16.21",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "three": "0.180.0",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/hast": "3.0.4",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "playwright": "1.63.0",
    "shiki": "4.4.3",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
