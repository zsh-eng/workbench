n```\\n\\n| Filter     | Example               |\\n| ---------- | --------------------- |\\n| Region     | `region:alps`         |\\n| Difficulty | `difficulty:moderate` |\\n\\nRelated: [[Trail data]] and [[Accessibility checklist]].\\n\",\"plain\":false,\"vault\":{\"id\":\"vault_4da72cfda616aebd00c79db2\",\"path\":\"Search filters.md\"}}"},{"method":"POST","url":"/api/service/status","body":"{}","status":200,"type":"application/json; charset=utf-8","text":"{\"service\":\"med\",\"version\":1,\"pid\":23640,\"home\":\"/work/home\",\"sources\":[{\"id\":\"vault_4da72cfda616aebd00c79db2\",\"kind\":\"vault\",\"path\":\"/work/trailhead-notes\",\"identity\":\"144508479:1791723160663.2302\",\"name\":\"trailhead-notes\",\"index\":{\"state\":\"ready\",\"revision\":2,\"result\":{\"files\":4,\"notes\":4,\"failedNotes\":0,\"links\":6,\"embeds\":0,\"unresolved\":0,\"ambiguous\":0,\"parsed\":0,\"readBytes\":0,\"changed\":0,\"removed\":0,\"failures\":0,\"resolvedLinks\":0,\"timings\":{\"enumerateMs\":0.640041999999994,\"readMs\":0,\"parseMs\":0,\"updateMs\":0.09279099999997698,\"resolveAndCommitMs\":1.4618340000000103,\"totalMs\":2.197749999999985}}},\"watching\":true}]}"},{"method":"POST","url":"/api/service/status","body":"{}","status":200,"type":"application/json; charset=utf-8","text":"{\"service\":\"med\",\"version\":1,\"pid\":23640,\"home\":\"/work/home\",\"sources\":[{\"id\":\"vault_4da72cfda616aebd00c79db2\",\"kind\":\"vault\",\"path\":\"/work/trailhead-notes\",\"identity\":\"144508479:1791723160663.2302\",\"name\":\"trailhead-notes\",\"index\":{\"state\":\"ready\",\"revision\":2,\"result\":{\"files\":4,\"notes\":4,\"failedNotes\":0,\"links\":6,\"embeds\":0,\"unresolved\":0,\"ambiguous\":0,\"parsed\":0,\"readBytes\":0,\"changed\":0,\"removed\":0,\"failures\":0,\"resolvedLinks\":0,\"timings\":{\"enumerateMs\":0.640041999999994,\"readMs\":0,\"parseMs\":0,\"updateMs\":0.09279099999997698,\"resolveAndCommitMs\":1.4618340000000103,\"totalMs\":2.197749999999985}}},\"watching\":tru