ps]\\n```\\n\\n| Filter     | Example               |\\n| ---------- | --------------------- |\\n| Region     | `region:alps`         |\\n| Difficulty | `difficulty:moderate` |\\n\\nRelated: [[Trail data]] and [[Accessibility checklist]].\\n\",\"plain\":false,\"vault\":{\"id\":\"vault_951c7385fca0b638e745493a\",\"path\":\"Search filters.md\"}}"},{"method":"POST","url":"/api/service/status","body":"{}","status":200,"type":"application/json; charset=utf-8","text":"{\"service\":\"med\",\"version\":1,\"pid\":88067,\"home\":\"/work/home\",\"sources\":[{\"id\":\"vault_951c7385fca0b638e745493a\",\"kind\":\"vault\",\"path\":\"/work/trailhead-notes\",\"identity\":\"143909176:1791690044890.7036\",\"name\":\"trailhead-notes\",\"index\":{\"state\":\"ready\",\"revision\":2,\"result\":{\"files\":4,\"notes\":4,\"failedNotes\":0,\"links\":6,\"embeds\":0,\"unresolved\":0,\"ambiguous\":0,\"parsed\":0,\"readBytes\":0,\"changed\":0,\"removed\":0,\"failures\":0,\"resolvedLinks\":0,\"timings\":{\"enumerateMs\":0.697291000000007,\"readMs\":0,\"parseMs\":0,\"updateMs\":0.10208399999999074,\"resolveAndCommitMs\":1.4245829999999842,\"totalMs\":2.2265409999999974}}},\"watching\":true}]}"},{"method":"POST","url":"/api/service/status","body":"{}","status":200,"type":"application/json; charset=utf-8","text":"{\"service\":\"med\",\"version\":1,\"pid\":88067,\"home\":\"/work/home\",\"sources\":[{\"id\":\"vault_951c7385fca0b638e745493a\",\"kind\":\"vault\",\"path\":\"/work/trailhead-notes\",\"identity\":\"143909176:1791690044890.7036\",\"name\":\"trailhead-notes\",\"index\":{\"state\":\"ready\",\"revision\":2,\"result\":{\"files\":4,\"notes\":4,\"failedNotes\":0,\"links\":6,\"embeds\":0,\"unresolved\":0,\"ambiguous\":0,\"parsed\":0,\"readBytes\":0,\"changed\":0,\"removed\":0,\"failures\":0,\"resolvedLinks\":0,\"timings\":{\"enumerateMs\":0.697291000000007,\"readMs\":0,\"parseMs\":0,\"updateMs\":0.10208399999999074,\"resolveAndCommitMs\":1.4245829999999842,\"totalMs\":2.2265409999999974}}},\"watchin